# Local keys for the Edocs API. Loaded by application.yml (spring.config.import); OS environment variables override these.
# Copy to .env and fill in. Generate keys with: openssl rand -base64 48 (JWT) and openssl rand -base64 32 (MASTER_KEY).

PORT=8080
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:4173

# PostgreSQL (relational data, Flyway migrations)
DB_URL=jdbc:postgresql://localhost:5432/edocs
DB_USER=edocs
DB_PASSWORD=edocs
DB_POOL_SIZE=10

# MongoDB (encrypted document bodies, signature images)
MONGO_URI=mongodb://localhost:27017/edocs

# RabbitMQ (email/SMS notifications, domain events)
RABBIT_HOST=localhost
RABBIT_PORT=5672
RABBIT_USER=edocs
RABBIT_PASSWORD=edocs

# SMTP (Mailpit locally: UI on http://localhost:8025)
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=no-reply@edocs.local

# Security
JWT_SECRET=change-me-at-least-32-characters-long-random-string
JWT_TTL=PT2H
MASTER_KEY=change-me-base64-encoded-32-byte-key

# OAuth2 single sign-on (register http://localhost:8080/api/login/oauth2/code/{google|microsoft} as redirect URI)
GOOGLE_CLIENT_ID=google-client-id-not-set
GOOGLE_CLIENT_SECRET=google-client-secret-not-set
MICROSOFT_CLIENT_ID=microsoft-client-id-not-set
MICROSOFT_CLIENT_SECRET=microsoft-client-secret-not-set

# Seed data and demo shortcuts (empty/false = real codes delivered by email through RabbitMQ)
SEED_DEMO_DATA=true
DEMO_PASSWORD=Demo@2026
DEMO_MFA_CODE=
OTP_ECHO_IN_APP=false
